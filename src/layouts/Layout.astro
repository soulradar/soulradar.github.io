---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Where Is My Soulmate From? — SoulRadar Astrology Country Finder",
  description = "Find where your soulmate lives with SoulRadar. 100% deterministic astrology, zodiac alignment, and Life Path numerology match you to your soulmate country.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="find my soulmate, where is my soulmate, my soulmate, soulmate country finder, astrology soulmate, numerology soulmate, zodiac love match, soulmate radar"
    />
    <meta name="author" content="SoulRadar" />
    <meta name="theme-color" content="#7C0E44" />
    <meta name="color-scheme" content="light dark" />

    <!-- Canonical URL -->
    <link rel="canonical" href="https://soulradar.github.io/" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://soulradar.github.io/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="SoulRadar" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content="https://soulradar.github.io/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SoulRadar — Where Is My Soulmate Astrology Radar" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://soulradar.github.io/" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://soulradar.github.io/og-image.png" />

    <!-- PWA & Mobile Web App Manifest -->
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/icon.svg" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="SoulRadar" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-75QKKRLB1W"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-75QKKRLB1W');
    </script>

    <!-- Schema.org Structured Data (JSON-LD) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebApplication",
            "@id": "https://soulradar.github.io/#webapp",
            "name": "SoulRadar — Where Is My Soulmate?",
            "url": "https://soulradar.github.io/",
            "applicationCategory": "EntertainmentApplication",
            "operatingSystem": "All",
            "description": "Find your soulmate country and romantic city using deterministic astrological zodiac calculation, elemental harmony, and Pythagorean life path numerology.",
            "offers": {
              "@type": "Offer",
              "price": "0",
              "priceCurrency": "USD"
            },
            "featureList": [
              "Deterministic Zodiac & Numerology Soulmate Calculation",
              "Curated 60+ Global Romantic Destinations",
              "Interactive 2-Second Celestial Radar Scanner",
              "High-Resolution HTML5 Canvas Social Share Card Generation",
              "100% Offline Progressive Web App (PWA) Support",
              "8 Multilingual Internationalization Options"
            ]
          },
          {
            "@type": "BreadcrumbList",
            "@id": "https://soulradar.github.io/#breadcrumb",
            "itemListElement": [
              {
                "@type": "ListItem",
                "position": 1,
                "name": "Home",
                "item": "https://soulradar.github.io/"
              },
              {
                "@type": "ListItem",
                "position": 2,
                "name": "SoulRadar Soulmate Country Finder",
                "item": "https://soulradar.github.io/#radar"
              }
            ]
          },
          {
            "@type": "HowTo",
            "@id": "https://soulradar.github.io/#howto",
            "name": "How to Find Your Soulmate's Country with SoulRadar",
            "description": "3 simple steps to calculate your cosmic love coordinates using deterministic astrology and numerology.",
            "step": [
              {
                "@type": "HowToStep",
                "position": 1,
                "name": "Enter Your Celestial Details",
                "text": "Input your name or username, date of birth, and romantic orientation to establish your zodiac and life path baseline."
              },
              {
                "@type": "HowToStep",
                "position": 2,
                "name": "Initialize SoulRadar Scanning",
                "text": "Activate the celestial radar pulse to sweep global coordinates and match your energetic frequency against 60+ countries."
              },
              {
                "@type": "HowToStep",
                "position": 3,
                "name": "Discover Your Soulmate Country & Share",
                "text": "Unveil your matched soulmate country, romantic city, cosmic resonance score, and export an aesthetic shareable PNG card."
              }
            ]
          },
          {
            "@type": "FAQPage",
            "@id": "https://soulradar.github.io/#faq",
            "mainEntity": [
              {
                "@type": "Question",
                "name": "How do I find my soulmate with SoulRadar?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "SoulRadar analyzes your birth date to determine your Western Zodiac sign, elemental polarity (Fire, Earth, Air, Water), and Pythagorean Life Path number. It combines these with a deterministic hash of your name to calculate your optimal soulmate country and romantic destination."
                }
              },
              {
                "@type": "Question",
                "name": "Where is my soulmate located according to astrology?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Astrology maps energetic resonance between zodiac signs and geographic astrolocality. SoulRadar evaluates mutual elemental harmony and planetary ruler alignments to pinpoint where your soulmate's energetic signature is most concentrated across 60+ global destinations."
                }
              },
              {
                "@type": "Question",
                "name": "Is SoulRadar deterministic and privacy-friendly?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Yes. SoulRadar executes 100% locally in your web browser. Zero personal data or dates of birth are transmitted to any server or third party. The same inputs will always produce the exact same soulmate country match."
                }
              },
              {
                "@type": "Question",
                "name": "Can I download and share my soulmate radar card?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Yes! SoulRadar includes a built-in HTML5 Canvas generator that produces high-resolution, aesthetic PNG cards designed for sharing on X (Twitter), Instagram Stories, WhatsApp, and messaging apps."
                }
              },
              {
                "@type": "Question",
                "name": "Can I use SoulRadar offline?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Yes, SoulRadar is a fully compliant Progressive Web App (PWA). You can install it on your iOS or Android home screen or desktop and use it anytime without an active internet connection."
                }
              }
            ]
          }
        ]
      }
    </script>

    <!-- Theme Initialization Script to Prevent Flicker -->
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('soulradar_theme');
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (savedTheme === 'dark' || (!savedTheme && systemDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      } catch (e) {}
    </script>
  </head>
  <body class="min-h-screen bg-[#FFFDFB] text-[#7C0E44] antialiased transition-colors duration-300 dark:bg-[#14040C] dark:text-[#F2DACE]">
    <slot />

    <script is:inline>
      if ('serviceWorker' in navigator && window.location.protocol.startsWith('http')) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </body>
</html>
